                                <h3>Status sinkronizacije artikala</h3>
                                <p class="text-muted">
                                    Pregled nesinkroniziranih artikala i problema sa slikama, cijenom ili podacima iz tablice
                                    <code>oc_product_asset_sync</code>.
                                </p>
                            </div>
                            <div class="col-md-6">

                                {% if asset_stats.total > 0 %}
                                    <div class="row" style="margin-bottom:15px;">

                                        <div class="col-sm-2">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status"
                                               class="btn btn-default btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Ukupno</strong>
                                                <span class="badge pull-right" style="background:#777;">{{ asset_stats.total }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-2">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status&filter_status=ok"
                                               class="btn btn-success btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>OK</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#5cb85c;">{{ asset_stats.ok }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-3">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status&filter_status=missing_product"
                                               class="btn btn-danger btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Nedostaje proizvod</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#d9534f;">{{ asset_stats.missing_product }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-3">
                                            <a href="{{ filter_action }}&tab=status&filter_status=partial"
                                               class="btn btn-warning btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Djelomično / problemi</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#f0ad4e;">{{ asset_stats.partial }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-2">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status&filter_status=missing_folder"
                                               class="btn btn-danger btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Nedostaje folder</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#d9534f;">{{ asset_stats.missing_folder }}</span>
                                            </a>
                                        </div>

                                    </div>
                                {% endif %}


                            </div>
                        </div>

                        <form action="{{ filter_action }}" method="get" class="form-inline" style="margin-bottom:10px;">
                            <input type="hidden" name="user_token" value="{{ user_token }}"/>
                            <input type="hidden" name="route" value="extension/module/qiqo"/>
                            <input type="hidden" name="tab" value="status"/>

