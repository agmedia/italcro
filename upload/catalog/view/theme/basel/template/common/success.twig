{{ header }}
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1 id="page-title">{{ heading_title }}</h1>
      <div class="inline-link text-center" style="border:3px solid #34aae1;
padding:50px ;">{{ text_message }}</div>

   


      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{% if clear_quick_order is defined and clear_quick_order %}
<script>
(function() {
  try {
    localStorage.removeItem('qo_items_v2');
    localStorage.removeItem('qo_items_v1');
  } catch (e) {}
})();
</script>
{% endif %}
{{ footer }}
