{{ header }}
<style>
    .mpn-variants .qiqo-action-cell {
        width: 32px;
        min-width: 32px;
        text-align: center;
    }
    .mpn-variants .qiqo-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border: 0;
        background: #ec008c;
        color: #fff;
        font-size: 17px;
        font-weight: 700;
        line-height: 1;
        padding: 0;
    }
    .mpn-variants .mpn-packaging {
        white-space: nowrap;
    }
    .mpn-variants .mpn-vpc,
    .mpn-variants .mpn-final-price {
        font-weight: 700;
        white-space: nowrap;
    }
    .mpn-variants .mpn-qty-input {
        width: 92px;
        min-width: 92px;
        text-align: center;
    }
    .mpn-variants .mpn-addtocart {
        min-width: 190px;
    }
    .wishlist-variants .wishlist-actions {
        padding: 0 5px 0 0;
    }
    .wishlist-variants .wishlist-actions .info {
        display: block;
        line-height: 24px;
    }
</style>
<div class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if success %}
  <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-md-9 col-sm-8' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1 id="page-title">{{ heading_title }}</h1>
      
      {% if products %}
        {% set wishlist_colspan = show_prices ? (wishlist_has_c100 ? 12 : 11) : 5 %}
        <div class="mpn-variants wishlist-variants table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th class="qiqo-action-cell"></th>
                <th>Šifra</th>
                <th>Barcode</th>
                <th>Atribut</th>
                <th>Pakiranje</th>
                {% if show_prices %}
                <th class="text-right">Zaliha</th>
                  {% if wishlist_has_c100 %}
                  <th class="text-right">C-100</th>
                  {% endif %}
                <th class="text-right price">VPC</th>
                <th class="text-right">Rabat</th>
                <th class="text-right price">Cijena</th>
                <th class="text-right price">Dodaj</th>
                <th></th>
                {% endif %}
              </tr>
            </thead>
            <tbody>
              {% for product in products %}
              <tr>
                <td class="qiqo-action-cell">
                  {% if product.qiqo_action is defined and product.qiqo_action %}
                    <button type="button"
                            class="qiqo-action-button"
                            data-toggle="modal"
                            data-target="#wishlistQiqoActionModal{{ product.product_id }}"
                            title="Uvjeti akcijskog cjenika"
                            aria-label="Uvjeti akcijskog cjenika za artikl {{ product.code }}">A</button>
                  {% endif %}
                </td>
                <td>{{ product.code }}</td>
                <td>{{ product.barcode }}</td>
                <td>{{ product.name_add ? product.name_add : product.name }}</td>
                <td class="mpn-packaging">{{ product.packaging }}</td>
                {% if show_prices %}
                <td class="text-right">{{ product.stock }}</td>
                  {% if wishlist_has_c100 %}
                  <td class="text-right">{{ product.cent }}</td>
                  {% endif %}
                <td class="text-right price mpn-vpc">{{ product.vpc }}</td>
                <td class="text-right">
                  {% if product.qiqo_discount_percent is defined and product.qiqo_discount_percent > 0 %}
                    -{{ product.qiqo_discount_percent|number_format(0, '.', '') }}%
                  {% else %}
                    -
                  {% endif %}
                </td>
                <td class="text-right price mpn-final-price">{{ product.final_price }}</td>
                <td class="text-right price">
                  <div class="input-group addtocart mpn-addtocart" style="margin-left:auto;">
                    <span class="input-group-btn">
                      <button type="button"
                              class="btn btn-default btn-number"
                              data-type="minus"
                              onclick="descrement($(this).closest('.addtocart')); ">
                        <span class="glyphicon glyphicon-minus"></span>
                      </button>
                    </span>
                    <input type="text"
                           name="quantity_{{ product.product_id }}"
                           class="form-control input-number mpn-qty-input"
                           value="{{ product.minimumifc100 }}"
                           min="{{ product.minimumifc100 }}"
                           min-step="{{ product.minimumifc100 }}"
                           data-pak="{{ product.pak is defined ? product.pak : 0 }}"
                           {% if product.pak is defined and product.pak == 1 %}readonly="readonly"{% endif %}
                           data-id="{{ product.product_id }}"
                           inputmode="decimal"
                           maxlength="8"
                           aria-label="Količina">
                    <span class="input-group-btn">
                      <button type="button"
                              class="btn btn-default btn-number"
                              data-type="plus"
                              onclick="increment($(this).closest('.addtocart')); ">
                        <span class="glyphicon glyphicon-plus"></span>
                      </button>
                    </span>
                    <span class="input-group-btn">
                      <button type="button"
                              class="btn btn-neutral"
                              onclick="var quantityInput = $(this).closest('.addtocart').find('.input-number'); cart.add('{{ product.product_id }}', quantityInput.val().replace(/\./g, '').replace(',', '.'));">
                        <span class="global-cart"></span>
                      </button>
                    </span>
                  </div>
                </td>
                <td>
                  <div class="wishlist-actions">
                    <span class="info is_wishlist"><a href="{{ product.remove }}" title="{{ button_remove }}"><i class="icon-heart"></i> </a></span>
                    <span class="info is_compare"><a onclick="compare.add('{{ product.product_id }}');"><i class="icon-refresh"></i> </a></span>
                  </div>
                </td>
                {% endif %}
              </tr>
                {% if product.description_add != '' %}
                <tr>
                  <td colspan="{{ wishlist_colspan }}"><small>{{ product.description_add }}</small></td>
                </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        </div>

        {% for product in products %}
          {% if product.qiqo_action is defined and product.qiqo_action and product.qiqo_action_conditions is defined and product.qiqo_action_conditions|length > 0 %}
            <div class="modal fade qiqo-action-modal" id="wishlistQiqoActionModal{{ product.product_id }}" tabindex="-1" role="dialog" aria-labelledby="wishlistQiqoActionModalLabel{{ product.product_id }}">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Zatvori"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="wishlistQiqoActionModalLabel{{ product.product_id }}">Akcijski uvjeti - {{ product.code }}</h4>
                  </div>
                  <div class="modal-body">
                    <table class="table table-condensed table-bordered">
                      <thead>
                        <tr>
                          <th>Oznaka</th>
                          <th class="text-right">Količina</th>
                          <th class="text-right">Cijena</th>
                          <th class="text-right">Rabat</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for condition in product.qiqo_action_conditions %}
                          <tr>
                            <td>{{ condition.indicator }}</td>
                            <td class="text-right">{{ condition.quantity }}</td>
                            <td class="text-right">{{ condition.price }}</td>
                            <td class="text-right">{{ condition.discount }}</td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}

      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}
      
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
