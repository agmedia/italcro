<div class="header-wrapper header6 italcro-header">

{% if top_line_style %}
<div class="top_line">
  <div class="container {{ top_line_width }}">
    <div class="table">
        <div class="table-cell left ">
            <div class="promo-message">{{ promo_message }}</div>
        </div>
        <div class="table-cell text-right ">
            <div class="links">
            <ul>
            {% include 'basel/template/common/static_links.twig' %}
            </ul>
            {% if lang_curr_title  %}
            <div class="setting-ul">
            <div class="setting-li dropdown-wrapper from-left lang-curr-trigger nowrap"><a>
            <span><img src="image/{{ lang }}.png" alt="{{ lang_curr_title }}" title="{{ lang_curr_title }}"> {{ lang_curr_title }}</span>
            </a>
            <div class="dropdown-content dropdown-right lang-curr-wrapper">
            {{ language }}
            {{ currency }}
            </div>
            </div>
            </div>
            {% endif %}
            </div>
        </div>
    </div> <!-- .table ends -->
  </div> <!-- .container ends -->
</div> <!-- .top_line ends -->
{% endif %}

<span class="table header-main sticky-header-placeholder ">&nbsp;</span>
<div class=" outer-container header-style sticky-header">
  <div class="container {{ main_header_width }}">
    <div class="table header-main italcro-header-row {{ main_menu_align }}">

    
    
    <div class="table-cell text-left  w15 logo">

        <div id="logo">
         
        <a href="{{ home }}" aria-label="{{ name|escape('html_attr') }} – Naslovnica"><img src="image/italcro-logo-front.svg" title="{{ name }}" alt="{{ name }}" /></a>
        </div>

    </div>
    
    {% if primary_menu %}
    <div class="table-cell text-center w60 menu-cell hidden-xs hidden-sm">
        <nav class="main-menu italcro-primary-nav" aria-label="Glavna navigacija">
            <ul class="categories">
              {% if primary_menu == 'oc' %}
                <!-- Default menu -->
                {{ default_menu }}
              {% elseif primary_menu is defined %} 
                <!-- Mega menu -->
                {% for key, row in primary_menu_desktop %}
                {% include 'basel/template/common/menus/mega_menu.twig' %}
                {% endfor %}
              {% endif %}
            </ul>
        </nav>
    </div>
    {% endif %}
  
    <div class="table-cell w25 btns shortcuts text-right">
       
       <div class="font-zero italcro-header-shortcuts">

           {% if is_admin_logged or logged %}
               <button id="togglePrices" type="button" class="btn btn-outline header-price-toggle" title="Prikaži ili sakrij cijene" aria-label="Prikaži ili sakrij cijene">
                   <i class="fa fa-eye" aria-hidden="true"></i>
               </button>
           {% endif %}


           <div class="icon-element account-actions">

               {% if logged %}
                   <a class="shortcut-wrapper wishlist account-shortcut" title="{{ customer_display_name ? customer_display_name|escape('html_attr') : text_account|escape('html_attr') }}" aria-label="Moj račun – {{ customer_display_name ? customer_display_name|escape('html_attr') : text_account|escape('html_attr') }}" href="{{ account }}">
                       <i class="icon-user icon" aria-hidden="true"></i><span class="account-label hidden-xs">{{ customer_display_name ? customer_display_name : text_account }}</span>
                   </a>
                   <a class="shortcut-wrapper account-logout hidden-xs" title="Odjava" aria-label="Odjava" href="{{ logout }}"><i class="fa fa-sign-out" aria-hidden="true"></i><span class="logout-label">Odjava</span>
                   </a>
               {% else %}
                   <a class="shortcut-wrapper wishlist" title="Prijava u moj račun" aria-label="Prijava u moj račun" href="{{ login }}">
                       <div class="wishlist-hover"><i class="icon-user icon" aria-hidden="true"></i></div>
                   </a>
               {% endif %}
           </div>


           <div class="icon-element is_compare hidden-xs">
        <a class="shortcut-wrapper compare" href="{{ compare }}" title="{{ text_compare }}" aria-label="{{ text_compare|escape('html_attr') }}">
        <div class="compare-hover"><i class="icon-refresh icon"></i><span class="counter compare-counter">{{ compare_counter }}</span></div>
        </a>
        </div>
           <div class="icon-element is_wishlist hidden-xs">
        <a class="shortcut-wrapper wishlist" href="{{ wishlist }}" title="Lista želja" aria-label="Lista želja">
        <div class="wishlist-hover"><i class="icon-heart icon"></i><span class="counter wishlist-counter">{{ wishlist_counter }}</span></div>
        </a>
        </div>
        
        <div class="icon-element catalog_hide">
        <div id="cart" class="dropdown-wrapper from-top">
        <a href="{{ shopping_cart }}" class="shortcut-wrapper cart" title="Košarica" aria-label="Košarica">
        <i id="cart-icon" class="global-cart icon"></i> <span id="cart-total" class="nowrap">
                <span class="counter cart-total-items">{{ cart_items }}</span></span>
        </a>
        <div class="dropdown-content dropdown-right hidden-sm hidden-xs">
        {{ cart }}
        </div>
        </div>
        </div>
        
        <div class="icon-element hidden-md hidden-lg">
        <button type="button" class="shortcut-wrapper menu-trigger" title="Izbornik" aria-label="Otvori izbornik" aria-controls="italcro-mobile-navigation" aria-expanded="false">
        <i class="icon-line-menu icon" aria-hidden="true"></i>
        </button>
        </div>
        
       </div>
        
    </div>
    
    </div> <!-- .table.header_main ends -->
  </div> <!-- .container ends -->

    <div class=" slidedown outer-container header-bottom  ">
        <div class="container {{ main_header_width }}">
            <div class="table italcro-header-search-row">
                {% if secondary_menu %}
                    <div class="table-cell w235 hidden-xs hidden-sm">
                        <div class="main-menu vertical vertical-menu-bg dropdown-wrapper from-bottom">
                            <button type="button" class="menu-heading" aria-label="Prikaži kategorije artikala">{{ basel_text_category }}<i class="fa fa-angle-down" aria-hidden="true"></i></button>
                            <ul class="categories vertical-menu-bg dropdown-content">
                                {% if secondary_menu == 'oc' %}
                                    <!-- Default menu -->
                                    {{ default_menu }}
                                {% elseif secondary_menu is defined %}
                                    <!-- Mega menu -->
                                    {% for key, row in secondary_menu_desktop %}
                                        {% include 'basel/template/common/menus/mega_menu.twig' %}
                                    {% endfor %}
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                {% endif %}

                <div class="table-cell w100 search-cell {{ basel_search_scheme }}">
                    {{ basel_search }}
                </div>



            </div>
        </div><!-- .container ends -->
    </div>
</div> <!-- .sticky ends -->



</div> <!-- .header_wrapper ends -->
