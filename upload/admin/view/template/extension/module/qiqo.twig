{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                <li><a href="{{ cancel }}">Modules</a></li>
                <li>{{ heading_title }}</li>
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if success %}
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">{{ text_edit }}</h3></div>
            <div class="panel-body">
                <form action="{{ action }}" method="post">
                    <button type="submit" name="action" value="import" class="btn btn-primary"><i class="fa fa-download"></i> {{ button_import }}</button>
                    <hr>

                    <button type="submit" name="action" value="update_qty" class="btn btn-info">
                        <i class="fa fa-cubes"></i> Ažuriraj količine
                    </button>

                    <button type="submit" name="action" value="update_price" class="btn btn-info">
                        <i class="fa fa-euro"></i> Ažuriraj cijene
                    </button>

                    <button type="submit" name="action" value="update_image" class="btn btn-info">
                        <i class="fa fa-image"></i> Ažuriraj slike
                    </button>

                    <hr>

                    <button type="submit" name="action" value="import_brands" class="btn btn-warning">
                        <i class="fa fa-registered"></i> Kreiraj proizvođače (brendove)
                    </button>
                </form>

                <hr>

                <form action="{{ action }}" method="post" class="mt-3">
                    <div class="row">
                        <div class="col-md-3">
                            <button type="submit" name="action" value="link_brands_erp" class="btn btn-primary">
                                <i class="fa fa-link"></i> Poveži proizvode s brendovima (prema ERP logopath)
                            </button>
                        </div>
                        <div class="col-md-3" style="padding-top:10px;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="only_empty" name="only_empty" value="1" checked>
                                <label class="form-check-label" for="only_empty">
                                    Ažuriraj <strong>samo proizvode bez proizvođača</strong>
                                </label>
                            </div>
                        </div>
                    </div>
                </form>

                <hr>

                <h3>Upload logotipa brendova</h3>

                <form action="{{ upload_action }}" method="post" enctype="multipart/form-data" style="margin-top:10px;">

                    <div class="form-group">
                        <label><i class="fa fa-file-archive-o"></i> Upload ZIP datoteke</label>
                        <input type="file" name="zip_file" class="form-control"/>
                        <small class="text-muted">ZIP može sadržavati više logotipa (jpg/png). Bit će raspakirani u /storega/upload/logo-brands/</small>
                    </div>

                    <div class="form-group">
                        <label><i class="fa fa-files-o"></i> Ili upload više slika odjednom</label>
                        <input type="file" name="images[]" multiple class="form-control"/>
                        <small class="text-muted">Dozvoljeni formati: JPG, PNG</small>
                    </div>

                    <button type="submit" class="btn btn-secondary">
                        <i class="fa fa-upload"></i> Uploadaj logotipe
                    </button>
                </form>


                <hr>
                <h4>Zadnji log</h4>
                <pre style="background:#f8f8f8; padding:10px; max-height:300px; overflow:auto;">{{ last_log }}</pre>

                <hr>
                <form action="{{ action }}" method="post" class="d-flex align-items-center gap-2 mt-2">
                    <button type="submit" name="action" value="clear_log" class="btn btn-outline-danger d-flex align-items-center gap-2"
                            onclick="return confirm('Želite li zaista obrisati sadržaj qiqo.log datoteke?');">
                        <i class="fa fa-trash"></i>
                        <span>Obriši log</span>
                    </button>
                    <small class="text-muted">Ova akcija će isprazniti sistemski log: <code>system/storage/logs/qiqo.log</code></small>
                </form>
            </div>
        </div>
    </div>

    {{ footer }}
</div>
