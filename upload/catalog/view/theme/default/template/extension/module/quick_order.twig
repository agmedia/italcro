<div class="quick-order box" data-text-add="{{ text_add }}">

  <div id="qo-toast" class="alert" style="display:none;"></div>
  <h3>Pretraga artikala</h3>

  <div class="quick-order-search">
    <input id="qo-search" class="form-control qo-input" type="text" placeholder="{{ text_search }}" autocomplete="off" />
    <div id="qo-suggestions" class="list-group" style="display:none;"></div>
  </div>

  <div class="table-responsive quick-order-responsive">
    <table class="table table-striped" id="qo-table" style="margin-top:10px;">
      <thead>
      <tr>
        <th class="qo-action-head"></th>
        <th>Slika</th>
        <th>{{ text_sku }}</th>
        <th>{{ text_name }}</th>
        <th>Atribut</th>
        <th>Pakiranje</th>
        <th>C-100</th>
        <th style="width:110px">{{ text_qty }}</th>
        <th>VPC</th>
        <th>Rabat</th>
        <th>{{ text_price }}</th>
        <th>Ukupno</th>
      </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

  <!-- Total blok -->
  <div id="qo-total-block" class="quick-order-total">
    <div class="inner">
      <strong>Ukupno:</strong>
      <span id="qo-total">0</span>
    </div>
  </div>

  <!-- Akcije -->
  <div id="qo-actions" style="margin-top:10px; text-align:right;">
    <div class="btn-group">
      <button class="btn btn-danger" style="margin-right:10px" id="qo-clear-all">{{ text_clear_all }}</button>
      <a href="index.php?route=checkout/checkout" class="btn btn-success" id="qo-checkout">{{ text_checkout }}</a>
    </div>
  </div>

</div>

<style>
  /* Tablica */
  .quick-order #qo-table.table > thead > tr > th,
  .quick-order #qo-table.table > tbody > tr > td { vertical-align: middle !important; }
  .quick-order #qo-table.table-striped > tbody > tr:nth-of-type(odd) { background-color: #f7f7f7; }
  .quick-order #qo-table tbody tr.success td { background-color: #e9f7ef !important; }
  .quick-order #qo-table .qo-action-cell,
  .quick-order #qo-table .qo-action-head { width: 32px; text-align: center; }
  .quick-order #qo-table td:nth-child(2),
  .quick-order #qo-table th:nth-child(2) { width: 80px; text-align: center; }
  .quick-order #qo-table td img { display:inline-block; width:60px; height:60px; object-fit:cover; }
  .quick-order #qo-table .qo-qty { height:34px; line-height:34px; padding:4px 8px; text-align:right;min-width: 50px; }
  .quick-order #qo-table .qo-price,
  .quick-order #qo-table .qo-total-cell,
  .quick-order #qo-table .qo-discount-cell { text-align:right; white-space:nowrap; }
  .quick-order #qo-table .qo-price-current,
  .quick-order #qo-table .qo-line-total { font-weight:700; }
  .quick-order #qo-table .qo-line-total { color:#00a9e0; }
  .quick-order #qo-table .qo-discount-action,
  .quick-order #qo-table .qo-price-net { color:#e4008a; }
  .quick-order .qiqo-action-button {
    width: 28px;
    height: 28px;
    border: 0;
    background: #e4008a;
    color: #fff;
    font-weight: 700;
    line-height: 28px;
    padding: 0;
  }
  .quick-order-responsive { width:100%; overflow-x:auto; -webkit-overflow-scrolling:touch; }

  @media (max-width:575.98px){
    .quick-order #qo-table td img { width:28px; height:28px; }
    .quick-order #qo-table .qo-qty { max-width:72px; }
    .quick-order #qo-table th:nth-child(5),
    .quick-order #qo-table td:nth-child(5),
    .quick-order #qo-table th:nth-child(6),
    .quick-order #qo-table td:nth-child(6) { display:none; }
  }
  .quick-order #qo-table th:nth-child(8),
  .quick-order #qo-table td:nth-child(8),
  .quick-order #qo-table th:nth-child(9),
  .quick-order #qo-table td:nth-child(9),
  .quick-order #qo-table th:nth-child(10),
  .quick-order #qo-table td:nth-child(10),
  .quick-order #qo-table th:nth-child(11),
  .quick-order #qo-table td:nth-child(11),
  .quick-order #qo-table th:nth-child(12),
  .quick-order #qo-table td:nth-child(12) { text-align:right; }

  /* Total */
  .quick-order-total { margin-top:15px; padding:10px 15px; text-align:right; background:#fff; font-size:1.8rem; color:#000; }
  .quick-order-total strong { color:#000; font-weight:500; }
  #qo-actions { margin-bottom:10px; }

  /* Autocomplete */
  .quick-order-search { position:relative;  margin-bottom:15px; }
  .qo-input { border-radius:10px; padding:10px 14px; border:1px solid #ccc; transition:all .2s; font-size:15px; }
  .qo-input:focus { border-color:#007bff; box-shadow:0 0 6px rgba(0,123,255,.25); }

  #qo-suggestions {
    position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:99; background:#fff;
    border:1px solid #e5e5e5; border-radius:10px; overflow-y:auto; max-height:350px;
    box-shadow:0 6px 18px rgba(0,0,0,.08);
  }
  .qo-suggest { display:block; padding:8px 12px; color:#333; text-decoration:none; transition:background .15s; outline:none; }
  .qo-suggest:hover, .qo-suggest:focus { background:#f7faff; text-decoration:none; }
  .qo-suggest-inner { display:flex; align-items:center; gap:12px; }
  .qo-thumb { flex-shrink:0; width:52px; height:52px; border-radius:8px; object-fit:cover; border:1px solid #eee; background:#fafafa; }
  .qo-thumb.placeholder { display:flex; justify-content:center; align-items:center; color:#bbb; }
  .qo-info { flex:1; line-height:1.25; }
  .qo-info .name { font-weight:600; color:#222; margin-bottom:3px; font-size:15px; }
  .qo-info .meta { display:flex; justify-content:normal; font-size:13px; color:#777; gap:10px; }
  .qo-info .price { font-weight:600; color:#000; }



  .qo-suggest.qty-mode .qo-suggest-qty,
  .qo-suggest.qty-mode .qo-add-btn { display:inline-block; }

  .qo-suggest-qty { width:72px; padding:6px 8px; border:1px solid #ccc; border-radius:0px; text-align:right;  }
  .qo-add-btn { background:#000; color:#fff; border:none; border-radius:6px; padding:6px 10px; font-size:13px; cursor:pointer; transition:all .2s; }
  .qo-add-btn:hover { background:#0069d9; }
  .qo-add-btn:active { transform:scale(0.96); }

  @media (max-width:576px){
    .qo-suggest-inner { gap:8px; }
    .qo-thumb { width:44px; height:44px; }
    .qo-info .meta { flex-direction:column; align-items:flex-start; gap:2px; }
    .qo-suggest-qty { width:64px; }
    .qo-add-btn { padding:5px 8px; }
  }

  #qo-suggestions .qo-suggest:focus {
    outline: none;
    background: #f7faff;
    box-shadow: inset 0 0 0 2px #e6f0ff;
  }

  /* Qty blok u autosuggestu – da se sve lijepo stisne i da se input vidi */
  .quick-order .qo-suggest-qty-wrap {
    display: flex;
    align-items: center;
    gap: 0;
    margin-left: auto;
    flex: 0 0 190px;          /* rezervira širinu desno za qty + gumbe */
    justify-content: flex-end;
  }

  .quick-order .qo-suggest-qty {
    width: 70px;
    min-width: 70px;
    text-align: right;
    height: 32px;
    padding: 3px 6px;
    font-size: 13px;
  }

  /* manji plus/minus u autosuggestu */
  .quick-order .qo-suggest-btn {
    padding: 8px 7px;
    min-width: 30px;
    font-size: 12px;
    line-height: 1;
  }


</style>

