{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ order_outbox }}" class="btn btn-info" title="NarudzbaSend red i kontrolirano ERP slanje">
                    <i class="fa fa-paper-plane"></i> NarudzbaSend
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                <li><a href="{{ cancel }}">Modules</a></li>
                <li>{{ heading_title }}</li>
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if success %}
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
        {% endif %}
        {% if error %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-triangle"></i> {{ error }}</div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">

                <ul class="nav nav-tabs">
                    <li class="{{ active_tab == 'sync' ? 'active' : '' }}">
                        <a href="#tab-sync" data-toggle="tab">
                            <i class="fa fa-refresh"></i> Ažuriranje podataka
                        </a>
                    </li>
                    <li class="{{ active_tab == 'assets' ? 'active' : '' }}">
                        <a href="#tab-assets" data-toggle="tab">
                            <i class="fa fa-picture-o"></i> Slike &amp; dokumenti
                        </a>
                    </li>
                    <li class="{{ active_tab == 'status' ? 'active' : '' }}">
                        <a href="#tab-status" data-toggle="tab">
                            <i class="fa fa-exclamation-triangle"></i> Status sinkronizacije
                        </a>
                    </li>
                    <li class="{{ active_tab == 'log' ? 'active' : '' }}">
                        <a href="#tab-log" data-toggle="tab">
                            <i class="fa fa-file-text-o"></i> Log
                        </a>
                    </li>
                </ul>

                <div class="tab-content" style="margin-top:15px;">

                    {# TAB 1: AŽURIRANJE PODATAKA #}
                    <div class="tab-pane {{ active_tab == 'sync' ? 'active' : '' }}" id="tab-sync">
                        <style>
                            #tab-sync .qiqo-actions .btn { white-space: normal; margin-bottom: 8px; }
                            #tab-sync .qiqo-section-toggle { display: block; }
                            #tab-sync .qiqo-section-toggle .fa-chevron-down { margin-top: 2px; }
                        </style>
                        <p class="text-muted">Ažurirajte artikle, podatke kupaca i njihove rabate iz ERP-a. Svaku radnju pokrećete zasebno, prema tome što se promijenilo.</p>

                        <form action="{{ action }}" method="post">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title"><i class="fa fa-refresh"></i> Redovno ažuriranje</h3>
                                </div>
                                <div class="panel-body">
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <h4>1. Postojeći artikli</h4>
                                            <p>Osvježite količine i status, redovne cijene ili dobavljače postojećih artikala prema promjenama u ERP-u.</p>
                                            <p class="help-block">Ažuriranje količina preuzima i status Aktivno iz ERP-a: neaktivan artikl skriva se na webshopu, a aktivan se ponovno uključuje.</p>
                                            <p class="help-block">Za nove artikle te promjene naziva, opisa i ostalih podataka otvorite potpuni uvoz kataloga u dodatnim opcijama ispod.</p>
                                        </div>
                                        <div class="col-sm-4 qiqo-actions">
                                            <button type="submit" name="action" value="update_qty" class="btn btn-primary btn-block">
                                                <i class="fa fa-cubes"></i> Ažuriraj količine i status
                                            </button>
                                            <button type="submit" name="action" value="update_price" class="btn btn-primary btn-block">
                                                <i class="fa fa-euro"></i> Ažuriraj cijene artikala
                                            </button>
                                            <button type="submit" name="action" value="update_article_partners" class="btn btn-default btn-block">
                                                <i class="fa fa-link"></i> Ažuriraj dobavljače na artiklima
                                            </button>
                                        </div>
                                    </div>

                                    <hr>

                                    <div class="row">
                                        <div class="col-sm-8">
                                            <h4>2. Kupci i uvjeti prodaje</h4>
                                            <p>Za promjene podataka kupaca, njihovih općih rabata, mjesta isporuke, komercijalista i akcijskog cjenika.</p>
                                            <p class="help-block">Posebne rabate za pojedini artikl ažurirajte u sljedećem koraku.</p>
                                        </div>
                                        <div class="col-sm-4 qiqo-actions">
                                            <button type="submit" name="action" value="sync_partner_base" class="btn btn-primary btn-block">
                                                <i class="fa fa-users"></i> Ažuriraj podatke kupaca i cjenike
                                            </button>
                                        </div>
                                    </div>

                                    <hr>

                                    <div class="row">
                                        <div class="col-sm-8">
                                            <h4>3. Rabati kupac–artikl</h4>
                                            <p>Preuzima posebne rabate dogovorene s kupcem za određeni artikl, primjerice 18% umjesto općeg rabata kupca od 15%.</p>
                                            <p class="help-block">Uvoz radi u pozadini na serveru. Napredak pratite ovdje, a praćenje se nastavlja i nakon osvježavanja stranice.</p>
                                        </div>
                                        <div class="col-sm-4 qiqo-actions">
                                            <button type="button" name="action" value="sync_partner_discounts" id="qiqo-discount-start" class="btn btn-primary btn-block">
                                                <i class="fa fa-percent"></i> <span>{% if partner_discount_incremental_ready %}Ažuriraj rabate kupac–artikl{% else %}Uvezi rabate iz ERP-a{% endif %}</span>
                                            </button>
                                        </div>
                                    </div>
                                    {% if not partner_discount_incremental_ready %}
                                        <div class="alert alert-info" id="qiqo-discount-initial-note" style="margin-bottom:0;">
                                            <i class="fa fa-info-circle"></i> Prvi uvoz preuzima cijeli skup rabata i može trajati dulje. Pokrenite ga ovim gumbom. Nakon prvog uvoza ažuriraju se samo promjene; postojeći rabati ostaju dostupni dok se novi podaci pripremaju.
                                        </div>
                                    {% endif %}
                                    <div id="qiqo-discount-progress" class="alert alert-info" style="display:none; margin-top:15px; margin-bottom:0;" role="status" aria-live="polite" aria-atomic="true">
                                        <p><i id="qiqo-discount-progress-icon" class="fa fa-refresh fa-spin"></i> <strong id="qiqo-discount-progress-title"></strong></p>
                                        <p id="qiqo-discount-message"></p>
                                        <p class="small" id="qiqo-discount-details">
                                            <span id="qiqo-discount-phase"></span>
                                            <span> · Obrađeni zapisi: <strong id="qiqo-discount-rows">0</strong></span>
                                            <span> · Preuzeto: <strong id="qiqo-discount-bytes">0 MB</strong></span>
                                        </p>
                                        <p class="small" id="qiqo-discount-updated"></p>
                                        <p id="qiqo-discount-refresh" style="display:none;"><a href="{{ action }}">Osvježi ostale opcije nakon uvoza</a></p>
                                    </div>
                                    <noscript><p class="text-danger">Za pokretanje i praćenje uvoza rabata omogućite JavaScript u pregledniku.</p></noscript>
                                </div>
                            </div>

                            <p class="help-block"><i class="fa fa-check-circle"></i> <strong>Nakon ažuriranja:</strong> provjerite poruku pri vrhu i karticu <a href="{{ action }}&amp;tab=log">Log</a>. Kod provjere cijene otvorite artikl kao odgovarajući kupac. Slike i dokumenti ažuriraju se zasebno u svojoj kartici.</p>

                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        <a class="qiqo-section-toggle collapsed" data-toggle="collapse" href="#qiqo-quick-updates" role="button" aria-expanded="false" aria-controls="qiqo-quick-updates">
                                            <i class="fa fa-chevron-down pull-right"></i>
                                            <i class="fa fa-bolt"></i> Dodatna ažuriranja i potpuni katalog
                                        </a>
                                    </h3>
                                </div>
                                <div class="panel-collapse collapse" id="qiqo-quick-updates">
                                    <div class="panel-body">
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Potpuni uvoz kataloga</h4>
                                                <p>Za nove artikle ili promjene naziva, opisa, zaliha, cijena, pakiranja, dobavljača, redoslijeda i aktivnosti.</p>
                                                <p class="help-block">Najprije pogledajte promjene, zatim pokrenite uvoz. Nakon uvoza nije potrebno zasebno ažurirati količine, cijene ni dobavljače.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="preview_catalog" class="btn btn-default btn-block"><i class="fa fa-search"></i> Pregled promjena prije uvoza</button>
                                                <button type="submit" name="action" value="import" class="btn btn-primary btn-block"><i class="fa fa-download"></i> Ažuriraj katalog iz ERP-a</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Komercijalisti ili akcijski cjenik</h4>
                                                <p class="help-block">Za promjene samo tih podataka. Oboje je već uključeno u korak 2.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_sales_reps" class="btn btn-default btn-block"><i class="fa fa-user"></i> Ažuriraj komercijaliste</button>
                                                <button type="submit" name="action" value="sync_action_prices" class="btn btn-default btn-block"><i class="fa fa-tags"></i> Ažuriraj akcijski cjenik</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Svi podaci kupaca u jednom koraku</h4>
                                                <p class="help-block">Zajedno izvršava korake 2 i 3: kupci, opći rabati, mjesta isporuke, komercijalisti, akcijski cjenik i rabati kupac–artikl.</p>
                                                {% if not partner_discount_incremental_ready %}
                                                    <p class="text-warning">Dostupno nakon početnog punjenja rabata. Do tada možete zasebno pokrenuti korak 2.</p>
                                                {% endif %}
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_partner_all" class="btn btn-primary btn-block"{% if not partner_discount_incremental_ready %} disabled title="Dostupno nakon početnog punjenja rabata na serveru"{% endif %}><i class="fa fa-refresh"></i> Ažuriraj sve podatke kupaca</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        <a class="qiqo-section-toggle collapsed" data-toggle="collapse" href="#qiqo-maintenance" role="button" aria-expanded="false" aria-controls="qiqo-maintenance">
                                            <i class="fa fa-chevron-down pull-right"></i>
                                            <i class="fa fa-wrench"></i> Početno postavljanje i održavanje
                                        </a>
                                    </h3>
                                </div>
                                <div class="panel-collapse collapse" id="qiqo-maintenance">
                                    <div class="panel-body">
                                        <p class="text-muted">Ove radnje koristite kod početnog postavljanja ili ciljane obnove podataka.</p>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Proizvođači i ERP grupe</h4>
                                                <p class="help-block">Kreirajte brendove iz pripremljenih logotipa, zatim povežite artikle s brendovima. Povezivanje ERP grupa zasebno osvježava grupiranje, nazive i opise artikala.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="import_brands" class="btn btn-default btn-block"><i class="fa fa-registered"></i> Kreiraj proizvođače (brendove)</button>
                                                <button type="submit" name="action" value="link_brands" class="btn btn-default btn-block"><i class="fa fa-link"></i> Poveži artikle s brendovima</button>
                                                <button type="submit" name="action" value="link_related_group" class="btn btn-default btn-block"><i class="fa fa-link"></i> Poveži ERP grupe</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Početni dohvat komercijalista</h4>
                                                <p class="help-block">Za prvo punjenje ili obnovu komercijalista: dohvaća podatke za zadnje dvije godine. Za redovne promjene koristite pojedinačno ažuriranje iznad.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_sales_reps_full" class="btn btn-default btn-block"><i class="fa fa-history"></i> Početni dohvat komercijalista</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Potpuna obnova podataka (FULL)</h4>
                                                <p class="help-block">Obnova podataka kupaca uključuje mjesta isporuke, komercijaliste i zamjenu akcijskog cjenika. Posebni rabati kupac–artikl uvoze se zasebno.</p>
                                                {% if not full_snapshot_enabled %}
                                                    <p class="text-warning"><i class="fa fa-lock"></i> Zaključano dok održavanje ne potvrdi da ERP vraća potpune podatke i ne pripremi početni datum. Redovno ažuriranje iznad ostaje dostupno.</p>
                                                {% endif %}
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_partner_base_full" class="btn btn-warning btn-block"{% if not full_snapshot_enabled %} disabled title="Potrebna je potvrda potpunosti ERP podataka i početni datum"{% endif %}><i class="fa fa-history"></i> Obnovi podatke kupaca (FULL)</button>
                                                <button type="submit" name="action" value="sync_action_prices_full" class="btn btn-warning btn-block"{% if not full_snapshot_enabled %} disabled title="Potrebna je potvrda potpunosti ERP podataka i početni datum"{% endif %}><i class="fa fa-history"></i> Zamijeni akcijski cjenik (FULL)</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Artikli kojih nema u ERP-u</h4>
                                                <p class="help-block">Zasebno isključuje artikle koji nedostaju u potvrđenom potpunom ERP katalogu.</p>
                                                {% if not disable_missing_enabled %}
                                                    <p class="text-warning"><i class="fa fa-lock"></i> Zaključano dok održavanje ne provjeri potpunost ERP kataloga i mogućnost sigurnog povrata promjena.</p>
                                                {% endif %}
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="disable_missing" class="btn btn-danger btn-block"{% if not disable_missing_enabled %} disabled title="Potrebna je provjera potpunog ERP kataloga i sigurnog povrata promjena"{% endif %}><i class="fa fa-ban"></i> Onemogući artikle kojih nema u ERP-u</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <script>
                        (function ($) {
                            'use strict';

                            $(function () {
                                var $button = $('#qiqo-discount-start');
                                var $progress = $('#qiqo-discount-progress');
                                var startUrl = '{{ discount_job_start|default('')|escape('js') }}'.replace(/&amp;/g, '&');
                                var statusUrl = '{{ discount_job_status|default('')|escape('js') }}'.replace(/&amp;/g, '&');
                                var csrf = '{{ discount_job_csrf|default('')|escape('js') }}';
                                var storageKey = 'qiqo-discount-job:' + '{{ action|escape('js') }}';
                                var ready = {{ partner_discount_incremental_ready ? 'true' : 'false' }};
                                var activeJobId = null;
                                var pollTimer = null;
                                var initialJob = null;
                                var phaseLabels = {
                                    queued: 'Čeka pokretanje',
                                    starting: 'Pokretanje',
                                    connecting: 'Povezivanje s ERP-om',
                                    download: 'Preuzimanje iz ERP-a',
                                    downloading: 'Preuzimanje iz ERP-a',
                                    parse: 'Čitanje podataka',
                                    parsing: 'Čitanje podataka',
                                    staging: 'Priprema podataka',
                                    validate: 'Provjera podataka',
                                    validating: 'Provjera podataka',
                                    import: 'Uvoz podataka',
                                    importing: 'Uvoz podataka',
                                    applying: 'Primjena rabata',
                                    publishing: 'Primjena rabata',
                                    completed: 'Završeno',
                                    failed: 'Prekinuto'
                                };

                                function storedJob(value) {
                                    try {
                                        if (arguments.length) {
                                            if (value) {
                                                window.sessionStorage.setItem(storageKey, value);
                                            } else {
                                                window.sessionStorage.removeItem(storageKey);
                                            }
                                        } else {
                                            return window.sessionStorage.getItem(storageKey);
                                        }
                                    } catch (error) {
                                        // The server still tracks the job when browser storage is unavailable.
                                    }
                                    return null;
                                }

                                function stateOf(job) {
                                    var state = job ? (job.state || job.status) : '';
                                    return state === 'complete' ? 'completed' : state;
                                }

                                function validJob(job) {
                                    return job && typeof job.id === 'string' && job.id.length > 0 &&
                                        ['queued', 'running', 'completed', 'failed'].indexOf(stateOf(job)) !== -1;
                                }

                                function setBusy(busy, starting) {
                                    $button.prop('disabled', busy);
                                    $button.find('i').attr('class', busy ? 'fa fa-refresh fa-spin' : 'fa fa-percent');
                                    $button.find('span').text(busy
                                        ? (starting ? 'Pokretanje uvoza…' : 'Uvoz je u tijeku…')
                                        : (ready ? 'Ažuriraj rabate kupac–artikl' : 'Uvezi rabate iz ERP-a'));
                                }

                                function showProblem(message, keepRunning) {
                                    $progress.removeClass('alert-info alert-success alert-warning alert-danger')
                                        .addClass(keepRunning ? 'alert-warning' : 'alert-danger').show();
                                    $('#qiqo-discount-progress-icon').attr('class', 'fa fa-exclamation-triangle');
                                    $('#qiqo-discount-progress-title').text(keepRunning
                                        ? 'Praćenje privremeno nije dostupno' : 'Uvoz nije potvrđen');
                                    $('#qiqo-discount-message').text(message);
                                    if (!keepRunning) {
                                        clearTimeout(pollTimer);
                                        activeJobId = null;
                                        storedJob(null);
                                        setBusy(false);
                                    }
                                }

                                function renderJob(job) {
                                    var state = stateOf(job);
                                    var running = state === 'queued' || state === 'running';
                                    var rows = Number(job.rows);
                                    var bytes = Number(job.bytes);
                                    var updatedAt = job.updated_at ? new Date(job.updated_at) : null;
                                    activeJobId = running ? job.id : null;
                                    storedJob(running ? job.id : null);
                                    if (state === 'completed') {
                                        ready = true;
                                        $('#qiqo-discount-initial-note').hide();
                                    }
                                    setBusy(running);
                                    $progress.removeClass('alert-info alert-success alert-warning alert-danger')
                                        .addClass(state === 'completed' ? 'alert-success' : (state === 'failed' ? 'alert-danger' : 'alert-info')).show();
                                    $('#qiqo-discount-progress-icon').attr('class', running
                                        ? 'fa fa-refresh fa-spin' : (state === 'completed' ? 'fa fa-check-circle' : 'fa fa-exclamation-triangle'));
                                    $('#qiqo-discount-progress-title').text(state === 'completed'
                                        ? 'Rabati su ažurirani' : (state === 'failed' ? 'Uvoz nije dovršen' : 'Uvoz rabata je u tijeku'));
                                    $('#qiqo-discount-message').text(job.message || (state === 'completed'
                                        ? 'Novi rabati su dostupni kupcima.' : (state === 'failed'
                                            ? 'Provjerite zapisnik i ponovno pokrenite uvoz.' : 'Uvoz se izvršava na serveru.')));
                                    $('#qiqo-discount-phase').text(phaseLabels[job.phase] || (running ? 'Obrada podataka' : phaseLabels[state]));
                                    $('#qiqo-discount-rows').text((isFinite(rows) && rows >= 0 ? rows : 0).toLocaleString('hr-HR'));
                                    $('#qiqo-discount-bytes').text(((isFinite(bytes) && bytes >= 0 ? bytes : 0) / 1048576).toLocaleString('hr-HR', { maximumFractionDigits: 1 }) + ' MB');
                                    $('#qiqo-discount-updated').text(job.updated_at ? 'Zadnja promjena: ' + (updatedAt && !isNaN(updatedAt.getTime())
                                        ? updatedAt.toLocaleString('hr-HR', { timeZone: 'Europe/Zagreb' }) : String(job.updated_at)) : '');
                                    $('#qiqo-discount-details').show();
                                    $('#qiqo-discount-refresh').toggle(state === 'completed');
                                    if (!running) {
                                        clearTimeout(pollTimer);
                                    }
                                    return running;
                                }

                                function schedulePoll(jobId, delay) {
                                    clearTimeout(pollTimer);
                                    pollTimer = setTimeout(function () { poll(jobId); }, delay);
                                }

                                function poll(jobId) {
                                    if (activeJobId !== jobId) {
                                        return;
                                    }
                                    $.ajax({
                                        url: statusUrl,
                                        type: 'GET',
                                        dataType: 'json',
                                        cache: false,
                                        timeout: 20000,
                                        data: { job_id: jobId }
                                    }).done(function (result) {
                                        if (activeJobId !== jobId) {
                                            return;
                                        }
                                        if (!result || !result.success || !validJob(result.job)) {
                                            showProblem(result && result.error ? result.error : 'Status uvoza nije dostupan. Osvježite stranicu i provjerite prijavu.', false);
                                            return;
                                        }
                                        if (renderJob(result.job)) {
                                            schedulePoll(result.job.id, 2500);
                                        }
                                    }).fail(function (xhr, textStatus) {
                                        if (activeJobId !== jobId) {
                                            return;
                                        }
                                        if (xhr.status === 401 || xhr.status === 403 || textStatus === 'parsererror') {
                                            showProblem('Prijava više nije aktivna ili server nije vratio status. Osvježite stranicu i provjerite prijavu.', false);
                                            return;
                                        }
                                        showProblem('Veza sa serverom je privremeno prekinuta. Ponovno provjeravamo status; uvoz se nastavlja na serveru.', true);
                                        schedulePoll(jobId, 5000);
                                    });
                                }

                                $button.on('click', function () {
                                    if ($button.prop('disabled')) {
                                        return;
                                    }
                                    if (!startUrl || !statusUrl) {
                                        showProblem('Pokretanje uvoza trenutno nije dostupno. Osvježite stranicu.', false);
                                        return;
                                    }
                                    clearTimeout(pollTimer);
                                    setBusy(true, true);
                                    $('#qiqo-discount-refresh').hide();
                                    $.ajax({
                                        url: startUrl,
                                        type: 'POST',
                                        dataType: 'json',
                                        timeout: 30000,
                                        data: { csrf: csrf }
                                    }).done(function (result) {
                                        if (!result || !result.success || !validJob(result.job)) {
                                            showProblem(result && result.error ? result.error : 'Server nije potvrdio pokretanje uvoza. Osvježite stranicu i provjerite status.', false);
                                            return;
                                        }
                                        if (renderJob(result.job)) {
                                            schedulePoll(result.job.id, 1000);
                                        }
                                    }).fail(function () {
                                        showProblem('Server nije potvrdio pokretanje uvoza. Osvježite stranicu prije ponovnog pokušaja; uvoz je možda već pokrenut.', false);
                                    });
                                });

                                try {
                                    initialJob = JSON.parse('{{ discount_job_json|default('null')|escape('js') }}');
                                } catch (error) {
                                    initialJob = null;
                                }
                                if (validJob(initialJob)) {
                                    if (renderJob(initialJob)) {
                                        schedulePoll(initialJob.id, 500);
                                    }
                                } else {
                                    var previousJobId = storedJob();
                                    if (previousJobId && statusUrl) {
                                        activeJobId = previousJobId;
                                        setBusy(true);
                                        schedulePoll(previousJobId, 100);
                                    }
                                }
                            });
                        }(jQuery));
                        </script>
                    </div>

