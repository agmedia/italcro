{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid">
    <div class="pull-right"><a href="{{ add }}" class="btn btn-primary" title="{{ button_add }}"><i class="fa fa-plus"></i></a> <button type="button" class="btn btn-danger" title="{{ button_delete }}" onclick="if (confirm('{{ text_confirm|escape('js') }}')) { document.getElementById('form-leaflet').submit(); }"><i class="fa fa-trash-o"></i></button></div>
    <h1>{{ heading_title }}</h1><ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
  </div></div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning|escape }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success|escape }}</div>{% endif %}
    {% if notice %}<div class="alert alert-warning"><i class="fa fa-info-circle"></i> {{ notice|escape }}</div>{% endif %}
    <div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title"><i class="fa fa-file-pdf-o"></i> {{ text_list }}</h3></div>
      <div class="panel-body">
        <form action="{{ delete }}" method="post" id="form-leaflet"><input type="hidden" name="csrf" value="{{ csrf|escape }}" />
          <div class="table-responsive"><table class="table table-bordered table-hover"><thead><tr>
            <td class="text-center" style="width:35px"><input type="checkbox" onclick="$('input[name=\'selected[]\']').prop('checked', this.checked);" /></td><td>{{ column_cover }}</td><td>{{ column_title }}</td><td>{{ column_date }}</td><td>{{ column_status }}</td><td class="text-right">{{ column_action }}</td>
          </tr></thead><tbody>{% for leaflet in leaflets %}<tr>
            <td class="text-center"><input type="checkbox" name="selected[]" value="{{ leaflet.leaflet_id }}" /></td>
            <td><img src="{{ leaflet.thumb|escape }}" alt="" width="70" height="95" style="object-fit:contain" /></td>
            <td><strong>{{ leaflet.title|escape }}</strong><div class="small text-muted">{{ leaflet.original_filename|escape }}</div></td>
            <td>{{ leaflet.published_at|date('d.m.Y.') }}</td><td>{{ leaflet.status ? text_enabled : text_disabled }}</td>
            <td class="text-right"><a class="btn btn-default" href="{{ leaflet.download }}" title="{{ button_download }}"><i class="fa fa-download"></i></a> <a class="btn btn-primary" href="{{ leaflet.edit }}" title="{{ button_edit }}"><i class="fa fa-pencil"></i></a></td>
          </tr>{% else %}<tr><td colspan="6" class="text-center">{{ text_no_results }}</td></tr>{% endfor %}</tbody></table></div>
        </form>
        <div class="row"><div class="col-sm-6">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div>
        <p class="help-block">{{ text_archive_help }}</p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
