{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ order_outbox }}" class="btn btn-info" title="NarudzbaSend red i kontrolirano ERP slanje">
                    <i class="fa fa-paper-plane"></i> NarudzbaSend
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                <li><a href="{{ cancel }}">Modules</a></li>
                <li>{{ heading_title }}</li>
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        {% if success %}
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
        {% endif %}
        {% if error %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-triangle"></i> {{ error }}</div>
        {% endif %}

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title"><i class="fa fa-plug"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">

                <ul class="nav nav-tabs">
                    <li class="{{ active_tab == 'sync' ? 'active' : '' }}">
                        <a href="#tab-sync" data-toggle="tab">
                            <i class="fa fa-refresh"></i> Ažuriranje podataka
                        </a>
                    </li>
                    <li class="{{ active_tab == 'assets' ? 'active' : '' }}">
                        <a href="#tab-assets" data-toggle="tab">
                            <i class="fa fa-picture-o"></i> Slike &amp; dokumenti
                        </a>
                    </li>
                    <li class="{{ active_tab == 'status' ? 'active' : '' }}">
                        <a href="#tab-status" data-toggle="tab">
                            <i class="fa fa-exclamation-triangle"></i> Status sinkronizacije
                        </a>
                    </li>
                    <li class="{{ active_tab == 'log' ? 'active' : '' }}">
                        <a href="#tab-log" data-toggle="tab">
                            <i class="fa fa-file-text-o"></i> Log
                        </a>
                    </li>
                </ul>

                <div class="tab-content" style="margin-top:15px;">

                    {# TAB 1: AŽURIRANJE PODATAKA #}
                    <div class="tab-pane {{ active_tab == 'sync' ? 'active' : '' }}" id="tab-sync">
                        <style>
                            #tab-sync .qiqo-actions .btn { white-space: normal; margin-bottom: 8px; }
                            #tab-sync .qiqo-section-toggle { display: block; }
                            #tab-sync .qiqo-section-toggle .fa-chevron-down { margin-top: 2px; }
                        </style>
                        <p class="text-muted">Odaberite što se promijenilo u ERP-u. Za cjelovito osvježavanje prvo ažurirajte katalog, zatim podatke kupaca i rabate.</p>

                        <form action="{{ action }}" method="post">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title"><i class="fa fa-refresh"></i> Redovno ažuriranje</h3>
                                </div>
                                <div class="panel-body">
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <h4>1. Katalog artikala</h4>
                                            <p>Za nove artikle ili promjene naziva, opisa, zaliha, cijena, pakiranja, dobavljača, redoslijeda i aktivnosti.</p>
                                            <p class="help-block">Najprije pogledajte promjene, zatim pokrenite uvoz. Nakon uvoza nije potrebno zasebno ažurirati količine, cijene ni dobavljače.</p>
                                        </div>
                                        <div class="col-sm-4 qiqo-actions">
                                            <button type="submit" name="action" value="preview_catalog" class="btn btn-default btn-block">
                                                <i class="fa fa-search"></i> Pregled promjena prije uvoza
                                            </button>
                                            <button type="submit" name="action" value="import" class="btn btn-primary btn-block">
                                                <i class="fa fa-download"></i> Ažuriraj katalog iz ERP-a
                                            </button>
                                        </div>
                                    </div>

                                    <hr>

                                    <div class="row">
                                        <div class="col-sm-8">
                                            <h4>2. Kupci i uvjeti prodaje</h4>
                                            <p>Za promjene podataka kupaca, njihovih općih rabata, mjesta isporuke, komercijalista i akcijskog cjenika.</p>
                                            <p class="help-block">Posebne rabate za pojedini artikl ažurirajte u sljedećem koraku.</p>
                                        </div>
                                        <div class="col-sm-4 qiqo-actions">
                                            <button type="submit" name="action" value="sync_partner_base" class="btn btn-primary btn-block">
                                                <i class="fa fa-users"></i> Ažuriraj podatke kupaca i cjenike
                                            </button>
                                        </div>
                                    </div>

                                    <hr>

                                    <div class="row">
                                        <div class="col-sm-8">
                                            <h4>3. Rabati kupac–artikl</h4>
                                            <p>Za poseban rabat dogovoren s kupcem za određeni artikl, primjerice 18% umjesto općeg rabata kupca od 15%.</p>
                                            {% if partner_discount_incremental_ready %}
                                                <p class="help-block">Preuzima promjene od zadnje uspješne sinkronizacije i čuva postojeće rabate.</p>
                                            {% else %}
                                                <div class="alert alert-warning" style="margin-bottom:0;">
                                                    <i class="fa fa-exclamation-triangle"></i> <strong>Potrebno je početno punjenje rabata.</strong>
                                                    Održavanje prvo treba uvesti cijeli skup od približno 2 milijuna zapisa na serveru. Nakon toga ovdje će biti dostupno redovno ažuriranje promjena. Postojeći rabati ostaju sačuvani.
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="col-sm-4 qiqo-actions">
                                            <button type="submit" name="action" value="sync_partner_discounts" class="btn btn-primary btn-block"{% if not partner_discount_incremental_ready %} disabled title="Dostupno nakon početnog punjenja rabata na serveru"{% endif %}>
                                                <i class="fa fa-percent"></i> Ažuriraj rabate kupac–artikl
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <p class="help-block"><i class="fa fa-check-circle"></i> <strong>Nakon ažuriranja:</strong> provjerite poruku pri vrhu i karticu <a href="{{ action }}&amp;tab=log">Log</a>. Kod provjere cijene otvorite artikl kao odgovarajući kupac. Slike i dokumenti ažuriraju se zasebno u svojoj kartici.</p>

                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        <a class="qiqo-section-toggle collapsed" data-toggle="collapse" href="#qiqo-quick-updates" role="button" aria-expanded="false" aria-controls="qiqo-quick-updates">
                                            <i class="fa fa-chevron-down pull-right"></i>
                                            <i class="fa fa-bolt"></i> Pojedinačna ažuriranja — kada ne trebate cijeli uvoz
                                        </a>
                                    </h3>
                                </div>
                                <div class="panel-collapse collapse" id="qiqo-quick-updates">
                                    <div class="panel-body">
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Količine artikala</h4>
                                                <p class="help-block">Kada želite osvježiti zalihe postojećih artikala bez cijelog kataloga. Osvježava i podatke o minimalnoj količini i pakiranju.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="update_qty" class="btn btn-default btn-block"><i class="fa fa-cubes"></i> Ažuriraj količine artikala</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Osnovne cijene artikala</h4>
                                                <p class="help-block">Kada su promijenjene redovne cijene u ERP-u. Za rabate pojedinog kupca koristite korake 2 i 3 iznad.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="update_price" class="btn btn-default btn-block"><i class="fa fa-euro"></i> Ažuriraj cijene artikala</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Dobavljači na artiklima</h4>
                                                <p class="help-block">Osvježava vezu artikla s dobavljačem iz ERP-a. Rabat kupca ažurira se kroz „Rabati kupac–artikl”.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="update_article_partners" class="btn btn-default btn-block"><i class="fa fa-link"></i> Ažuriraj dobavljače na artiklima</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Komercijalisti ili akcijski cjenik</h4>
                                                <p class="help-block">Za promjene samo tih podataka. Oboje je već uključeno u korak 2.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_sales_reps" class="btn btn-default btn-block"><i class="fa fa-user"></i> Ažuriraj komercijaliste</button>
                                                <button type="submit" name="action" value="sync_action_prices" class="btn btn-default btn-block"><i class="fa fa-tags"></i> Ažuriraj akcijski cjenik</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Svi podaci kupaca u jednom koraku</h4>
                                                <p class="help-block">Zajedno izvršava korake 2 i 3: kupci, opći rabati, mjesta isporuke, komercijalisti, akcijski cjenik i rabati kupac–artikl.</p>
                                                {% if not partner_discount_incremental_ready %}
                                                    <p class="text-warning">Dostupno nakon početnog punjenja rabata. Do tada možete zasebno pokrenuti korak 2.</p>
                                                {% endif %}
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_partner_all" class="btn btn-primary btn-block"{% if not partner_discount_incremental_ready %} disabled title="Dostupno nakon početnog punjenja rabata na serveru"{% endif %}><i class="fa fa-refresh"></i> Ažuriraj sve podatke kupaca</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h3 class="panel-title">
                                        <a class="qiqo-section-toggle collapsed" data-toggle="collapse" href="#qiqo-maintenance" role="button" aria-expanded="false" aria-controls="qiqo-maintenance">
                                            <i class="fa fa-chevron-down pull-right"></i>
                                            <i class="fa fa-wrench"></i> Početno postavljanje i održavanje
                                        </a>
                                    </h3>
                                </div>
                                <div class="panel-collapse collapse" id="qiqo-maintenance">
                                    <div class="panel-body">
                                        <p class="text-muted">Ove radnje koristite kod početnog postavljanja ili ciljane obnove podataka.</p>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Proizvođači i ERP grupe</h4>
                                                <p class="help-block">Kreirajte brendove iz pripremljenih logotipa, zatim povežite artikle s brendovima. Povezivanje ERP grupa zasebno osvježava grupiranje, nazive i opise artikala.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="import_brands" class="btn btn-default btn-block"><i class="fa fa-registered"></i> Kreiraj proizvođače (brendove)</button>
                                                <button type="submit" name="action" value="link_brands" class="btn btn-default btn-block"><i class="fa fa-link"></i> Poveži artikle s brendovima</button>
                                                <button type="submit" name="action" value="link_related_group" class="btn btn-default btn-block"><i class="fa fa-link"></i> Poveži ERP grupe</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Početni dohvat komercijalista</h4>
                                                <p class="help-block">Za prvo punjenje ili obnovu komercijalista: dohvaća podatke za zadnje dvije godine. Za redovne promjene koristite pojedinačno ažuriranje iznad.</p>
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_sales_reps_full" class="btn btn-default btn-block"><i class="fa fa-history"></i> Početni dohvat komercijalista</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Potpuna obnova podataka (FULL)</h4>
                                                <p class="help-block">Obnova podataka kupaca uključuje mjesta isporuke, komercijaliste i zamjenu akcijskog cjenika. Posebni rabati kupac–artikl uvoze se zasebno.</p>
                                                {% if not full_snapshot_enabled %}
                                                    <p class="text-warning"><i class="fa fa-lock"></i> Zaključano dok održavanje ne potvrdi da ERP vraća potpune podatke i ne pripremi početni datum. Redovno ažuriranje iznad ostaje dostupno.</p>
                                                {% endif %}
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="sync_partner_base_full" class="btn btn-warning btn-block"{% if not full_snapshot_enabled %} disabled title="Potrebna je potvrda potpunosti ERP podataka i početni datum"{% endif %}><i class="fa fa-history"></i> Obnovi podatke kupaca (FULL)</button>
                                                <button type="submit" name="action" value="sync_action_prices_full" class="btn btn-warning btn-block"{% if not full_snapshot_enabled %} disabled title="Potrebna je potvrda potpunosti ERP podataka i početni datum"{% endif %}><i class="fa fa-history"></i> Zamijeni akcijski cjenik (FULL)</button>
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="row">
                                            <div class="col-sm-8">
                                                <h4>Artikli kojih nema u ERP-u</h4>
                                                <p class="help-block">Zasebno isključuje artikle koji nedostaju u potvrđenom potpunom ERP katalogu.</p>
                                                {% if not disable_missing_enabled %}
                                                    <p class="text-warning"><i class="fa fa-lock"></i> Zaključano dok održavanje ne provjeri potpunost ERP kataloga i mogućnost sigurnog povrata promjena.</p>
                                                {% endif %}
                                            </div>
                                            <div class="col-sm-4 qiqo-actions">
                                                <button type="submit" name="action" value="disable_missing" class="btn btn-danger btn-block"{% if not disable_missing_enabled %} disabled title="Potrebna je provjera potpunog ERP kataloga i sigurnog povrata promjena"{% endif %}><i class="fa fa-ban"></i> Onemogući artikle kojih nema u ERP-u</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    {# TAB 2: SLIKE & DOKUMENTI #}
                    <div class="tab-pane {{ active_tab == 'assets' ? 'active' : '' }}" id="tab-assets">
                        {#<h3>Upload &amp; sync slika i dokumenata</h3>

                        <p class="text-muted">
                            ZIP treba imati root folder <code>Database</code> i unutra SKU foldere:<br>
                            <code>Database/{sku}/001_web.jpg, 002_web.jpg, {sku}_skl.pdf, {sku}_man.pdf, {sku}.stl, ...</code><br>
                            Nakon uploada datoteke se spremaju u <code>catalog/products/{sku}/</code> i vežu na proizvode.
                        </p>

                        <form action="{{ upload_action }}" method="post" enctype="multipart/form-data" style="margin-top:10px;">
                            <div class="form-group">
                                <label><i class="fa fa-file-archive-o"></i> Upload ZIP datoteke</label>
                                <input type="file" name="zip_file" class="form-control"/>
                                <small class="text-muted">
                                    ZIP može sadržavati više SKU foldera i dokumenata (JPG/PNG/PDF/STL).
                                </small>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-upload"></i> Uploadaj ZIP
                            </button>
                        </form>#}

                        <h3>Sync slika i dokumenata</h3>

                        <hr>

                        <form action="{{ action }}" method="post">
                            <button type="submit" name="action" value="update_assets_from_erp" class="btn btn-secondary">
                                <i class="fa fa-sync"></i>
                                <span>Rescan &amp; sinkroniziraj glavne slike -> ERP putanje</span>
                            </button>
                            <small class="text-muted" style="margin-left:10px;">
                                Ponovno provjerava ERP putanje <code>picpath</code>, puni glavne slike u proizvode.
                            </small>
                        </form>

                        <hr>

                        <form action="{{ action }}" method="post">
                            <button type="submit" name="action" value="update_assets" class="btn btn-secondary">
                                <i class="fa fa-sync"></i>
                                <span>Rescan &amp; sinkroniziraj slike i dokumente -> Folderi</span>
                            </button>
                            <small class="text-muted" style="margin-left:10px;">
                                Ponovno provjerava <code>(upload/Portals/0/...)</code> foldere, puni slike/dokumente u proizvode i tablicu <code>oc_product_asset_sync</code>.
                            </small>
                        </form>
                    </div>

                    {# TAB 3: STATUS SINKRONIZACIJE #}
                    <div class="tab-pane {{ active_tab == 'status' ? 'active' : '' }}" id="tab-status">
                        <div class="row">
                            <div class="col-md-6">
                                <h3>Status sinkronizacije artikala</h3>
                                <p class="text-muted">
                                    Pregled nesinkroniziranih artikala i problema sa slikama, cijenom ili podacima iz tablice
                                    <code>oc_product_asset_sync</code>.
                                </p>
                            </div>
                            <div class="col-md-6">

                                {% if asset_stats.total > 0 %}
                                    <div class="row" style="margin-bottom:15px;">

                                        <div class="col-sm-2">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status"
                                               class="btn btn-default btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Ukupno</strong>
                                                <span class="badge pull-right" style="background:#777;">{{ asset_stats.total }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-2">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status&filter_status=ok"
                                               class="btn btn-success btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>OK</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#5cb85c;">{{ asset_stats.ok }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-3">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status&filter_status=missing_product"
                                               class="btn btn-danger btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Nedostaje proizvod</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#d9534f;">{{ asset_stats.missing_product }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-3">
                                            <a href="{{ filter_action }}&tab=status&filter_status=partial"
                                               class="btn btn-warning btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Djelomično / problemi</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#f0ad4e;">{{ asset_stats.partial }}</span>
                                            </a>
                                        </div>

                                        <div class="col-sm-2">
                                            <a href="{{ filter_action }}&user_token={{ user_token }}&tab=status&filter_status=missing_folder"
                                               class="btn btn-danger btn-block text-left"
                                               style="padding:10px 12px;">
                                                <strong>Nedostaje folder</strong>
                                                <span class="badge pull-right" style="background:#fff; color:#d9534f;">{{ asset_stats.missing_folder }}</span>
                                            </a>
                                        </div>

                                    </div>
                                {% endif %}


                            </div>
                        </div>

                        <form action="{{ filter_action }}" method="get" class="form-inline" style="margin-bottom:10px;">
                            <input type="hidden" name="user_token" value="{{ user_token }}"/>
                            <input type="hidden" name="route" value="extension/module/qiqo"/>
                            <input type="hidden" name="tab" value="status"/>

                            <div class="form-group" style="margin-right:10px;">
                                <label for="filter_sku">SKU</label>
                                <input type="text" name="filter_sku" id="filter_sku" value="{{ filter_sku }}"
                                       class="form-control" placeholder="npr. 300050"/>
                            </div>

                            <div class="form-group" style="margin-right:10px;">
                                <label for="filter_status">Status</label>
                                <select name="filter_status" id="filter_status" class="form-control">
                                    <option value="">-- svi --</option>
                                    <option value="ok" {{ filter_status == 'ok' ? 'selected' : '' }}>OK</option>
                                    <option value="missing_product" {{ filter_status == 'missing_product' ? 'selected' : '' }}>Nedostaje proizvod</option>
                                    <option value="missing_folder" {{ filter_status == 'missing_folder' ? 'selected' : '' }}>Nedostaje folder</option>
                                    <option value="partial" {{ filter_status == 'partial' ? 'selected' : '' }}>Djelomično (problemi)</option>
                                </select>
                            </div>

                            <div class="checkbox" style="margin-right:10px;">
                                <label>
                                    <input type="checkbox" name="filter_has_product" value="1" {{ filter_has_product ? 'checked' : '' }}/> s proizvodom
                                </label>
                            </div>

                            <div class="checkbox" style="margin-right:10px;">
                                <label>
                                    <input type="checkbox" name="filter_has_folder" value="1" {{ filter_has_folder ? 'checked' : '' }}/> s folderom
                                </label>
                            </div>

                            <div class="checkbox" style="margin-right:10px;">
                                <label>
                                    <input type="checkbox" name="filter_missing_images" value="1" {{ filter_missing_images ? 'checked' : '' }}/> nedostaju slike
                                </label>
                            </div>

                            <div class="checkbox" style="margin-right:10px;">
                                <label>
                                    <input type="checkbox" name="filter_missing_price" value="1" {{ filter_missing_price ? 'checked' : '' }}/> nedostaje cijena
                                </label>
                            </div>

                            <div class="checkbox" style="margin-right:10px;">
                                <label>
                                    <input type="checkbox" name="filter_missing_sku_data" value="1" {{ filter_missing_sku_data ? 'checked' : '' }}/> nedostaju podaci
                                </label>
                            </div>

                            <button type="submit" class="btn btn-default">
                                <i class="fa fa-filter"></i> Filtriraj
                            </button>
                        </form>

                        {% if asset_sync is empty %}
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"></i> Trenutno nema zapisa (ili filter ne vraća rezultate).
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                    <tr>
                                        <th>SKU</th>
                                        <th>Proizvod</th>
                                        <th>Produkt</th>
                                        <th>Folder</th>
                                        <th>Slike</th>
                                        <th>Cijena</th>
                                        <th>Podaci</th>
                                        <th>Status</th>
                                        <th>Zadnja provjera</th>
                                        <th>Detalji</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for row in asset_sync %}
                                        <tr>
                                            <td><code>{{ row.sku }}</code></td>
                                            <td>
                                                {% if row.product_link %}
                                                    <a href="{{ row.product_link }}" target="_blank">
                                                        ID: {{ row.product_id }}
                                                    </a>
                                                {% else %}
                                                    <span class="text-danger">nije u bazi</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if row.has_product %}
                                                    <span class="label label-success">DA</span>
                                                {% else %}
                                                    <span class="label label-default">NE</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if row.has_folder %}
                                                    <span class="label label-success">DA</span>
                                                {% else %}
                                                    <span class="label label-default">NE</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if row.missing_images %}
                                                    <span class="label label-warning">nedostaju</span>
                                                {% else %}
                                                    <span class="label label-success">OK</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if row.missing_price %}
                                                    <span class="label label-warning">nedostaje</span>
                                                {% else %}
                                                    <span class="label label-success">OK</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if row.missing_sku_data %}
                                                    <span class="label label-warning">nedostaju</span>
                                                {% else %}
                                                    <span class="label label-success">OK</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if row.status == 'ok' %}
                                                    <span class="label label-success">OK</span>
                                                {% elseif row.status == 'missing_product' %}
                                                    <span class="label label-danger">nema proizvoda</span>
                                                {% elseif row.status == 'missing_folder' %}
                                                    <span class="label label-danger">nema foldera</span>
                                                {% elseif row.status == 'partial' %}
                                                    <span class="label label-warning">djelomično</span>
                                                {% else %}
                                                    <span class="label label-default">{{ row.status }}</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ row.last_checked }}</td>
                                            <td style="max-width:300px;">
                                                <small>{{ row.message }}</small>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>

                    {# TAB 4: LOG #}
                    <div class="tab-pane {{ active_tab == 'log' ? 'active' : '' }}" id="tab-log">
                        <h3>Zadnji log</h3>
                        <pre style="background:#f8f8f8; padding:10px; max-height:300px; overflow:auto;">{{ last_log }}</pre>

                        <form action="{{ action }}" method="post" class="mt-2">
                            <button type="submit" name="action" value="clear_log"
                                    class="btn btn-outline-danger d-flex align-items-center gap-2"
                                    onclick="return confirm('Želite li zaista obrisati sadržaj qiqo.log datoteke?');">
                                <i class="fa fa-trash"></i>
                                <span>Obriši log</span>
                            </button>
                            <small class="text-muted">
                                Ova akcija će isprazniti sistemski log:
                                <code>system/storage/logs/qiqo.log</code>
                            </small>
                        </form>
                    </div>

                </div> {# /.tab-content #}

            </div>
        </div>
    </div>

    {{ footer }}
</div>
